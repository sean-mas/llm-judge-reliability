# Copy to .env and fill in. .env is gitignored.
# Tier 1, paid frontier API
ANTHROPIC_API_KEY=
# Tier 2, free hosted tier
GOOGLE_API_KEY=
# Tier 3, local. Default Ollama endpoint, no key needed.
OLLAMA_HOST=http://localhost:11434

# Tier 2, hosted open-weights (Ollama Cloud).
# Create at https://ollama.com/settings/keys  ->  paste after the = sign.
# `ollama signin` authenticates the CLI but does NOT expose a key the harness
# can read, so this variable is required even if you are signed in.
OLLAMA_API_KEY=
